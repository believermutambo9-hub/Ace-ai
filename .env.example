# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# FOOTBALL_DATA_API_KEY: Football-Data.org API v4 Token (Direct Provider).
# Obtains fixtures, standings, live scores, and matches across 13 major leagues.
FOOTBALL_DATA_API_KEY=""

# API_FOOTBALL_KEY: Direct API-Sports key (v3.football.api-sports.io).
# Provides multi-tier leagues, live match stats, and real-time feeds.
API_FOOTBALL_KEY=""
